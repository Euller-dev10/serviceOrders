# Core
DJANGO_SETTINGS_MODULE=app.settings
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_DEBUG=True

# Domínio próprio em produção (EC2) — ex.: aferix.com.br,www.aferix.com.br
# Nunca usar ngrok em produção.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Produção: CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# Database (produção/staging: PostgreSQL; testes: sqlite em memória via app.test_settings)
POSTGRES_DB=serviceorders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sessão / segurança
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=43200
LOGIN_URL=/login/

# uWSGI (Docker)
UWSGI_PROCESSES=4

# Smoke test staging (após deploy): GET /login/ 200, POST login 302, GET /list_os/ 200

# IA / LLM (Sprint 2.1) — chaves só em env, nunca no BD
AI_DEFAULT_PROVIDER=OpenCode Zen
AI_DEFAULT_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_HISTORY_MAX_TOKENS=6000
AI_RATE_LIMIT_PER_USER=20
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
ANTHROPIC_API_KEY=

# E-mail transacional (console no MVP/dev; trocar por SMTP no prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@aferix.com.br

# Hardening / rate limiting
LOGIN_RATE_LIMIT_PER_WINDOW=5
LOGIN_RATE_WINDOW_SECONDS=300
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
ENABLE_CSP=False
AUDIT_LOG_RETENTION_DAYS=1825
